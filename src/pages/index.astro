---
import { Picture } from "astro:assets";
import portrait from "../assets/portrait.png";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { selectedWork, site } from "../data/site";
import { getCollection } from "astro:content";

const writing = (await getCollection("writing"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 2);
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="hero-kicker"><span>Software Engineer</span><span>Brooklyn, NY</span></p>
      <h1>I turn complex systems into <em>useful momentum.</em></h1>
      <p class="hero-intro">
        I’m Yashaswi—a full-stack engineer working across cloud infrastructure,
        developer platforms, and products built to scale.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={`mailto:${site.email}`}>Start a conversation <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-visual" aria-label="Portrait of Yashaswi Makula">
      <div class="portrait-frame">
        <Picture
          src={portrait}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[520, 760, 1040]}
          sizes="(max-width: 720px) 88vw, 40vw"
          alt="Yashaswi Makula smiling in a navy suit"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="orbit orbit-one" aria-hidden="true"></div>
      <div class="orbit orbit-two" aria-hidden="true"></div>
      <p class="visual-note"><span>3+</span> years building<br />production systems</p>
    </div>
    <p class="scroll-note" aria-hidden="true">Scroll to inspect <span>↓</span></p>
  </section>

  <section class="signal-strip" aria-label="Areas of expertise">
    <div>
      <span>Cloud systems</span><i></i><span>Developer experience</span><i></i><span>Full-stack engineering</span><i></i><span>Systems thinking</span>
    </div>
  </section>

  <section class="work shell section" id="work">
    <SectionHeading
      eyebrow="01 / Selected work"
      title="Proof over promises."
      intro="A few systems where the engineering translated directly into speed, reliability, or leverage."
    />
    <div class="work-list">
      {selectedWork.map((work) => (
        <article class="work-card" data-reveal>
          <div class="work-index">{work.index}</div>
          <div class="work-body">
            <p class="work-company">{work.company}</p>
            <h3>{work.title}</h3>
            <p>{work.summary}</p>
            <ul aria-label="Technologies used">
              {work.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
          <span class="work-arrow" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </section>

  <section class="principles section">
    <div class="shell principles-grid">
      <div data-reveal>
        <p class="eyebrow">02 / How I work</p>
        <h2>Scale is a design decision, not a rescue mission.</h2>
      </div>
      <div class="principle-list">
        <article data-reveal>
          <span>01</span><div><h3>Make the system legible</h3><p>Clear interfaces, observable behavior, and fewer surprises give teams room to move.</p></div>
        </article>
        <article data-reveal>
          <span>02</span><div><h3>Automate the repetition</h3><p>Good tooling turns operational knowledge into a reliable path that anyone can follow.</p></div>
        </article>
        <article data-reveal>
          <span>03</span><div><h3>Measure the outcome</h3><p>Technical elegance matters most when it improves speed, correctness, or the user experience.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="writing-preview shell section">
    <SectionHeading
      eyebrow="03 / Field notes"
      title="Ideas worth keeping."
      intro="Short notes from building, breaking, and understanding software systems."
    />
    <div class="article-grid">
      {writing.map((post) => (
        <a class="article-card" href={`/writing/${post.id}/`} data-reveal>
          <p><span>{post.data.topic}</span><time datetime={post.data.published.toISOString()}>{post.data.published.getFullYear()}</time></p>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <span class="read-link">Read note <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="contact-band">
    <div class="shell" data-reveal>
      <p class="eyebrow">04 / What’s next</p>
      <h2>Have a hard problem and a team that cares?</h2>
      <a href={`mailto:${site.email}`}>Let’s build something useful <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
