---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { experience, skillGroups, site } from "../data/site";
---

<BaseLayout title="About" description="Experience, education, and engineering practice of Yashaswi Makula.">
  <section class="page-hero shell">
    <p class="eyebrow">About / Experience</p>
    <h1>Engineering with equal parts <em>curiosity</em> and <em>discipline.</em></h1>
    <div class="page-intro">
      <p>I’m a software engineer drawn to the layer where infrastructure decisions become product outcomes.</p>
      <p>My work spans cloud platforms, secure systems, developer tooling, and full-stack experiences—with a bias toward making complicated things easier to operate.</p>
    </div>
  </section>

  <section class="shell section resume-section">
    <SectionHeading eyebrow="01 / Experience" title="Where I’ve contributed." />
    <div class="timeline">
      {experience.map((item) => (
        <article data-reveal>
          <div class="timeline-meta">
            <p>{item.period}</p><p>{item.location}</p>
          </div>
          <div class="timeline-body">
            <p>{item.company}</p><h2>{item.role}</h2>
            <ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="skills-section section">
    <div class="shell">
      <SectionHeading eyebrow="02 / Toolkit" title="Technologies are tools, not identities." />
      <div class="skill-grid">
        {skillGroups.map(([label, skills], index) => (
          <article data-reveal><span>0{index + 1}</span><h3>{label}</h3><p>{skills}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="education shell section">
    <SectionHeading eyebrow="03 / Education" title="A foundation in computer science." />
    <div class="education-grid">
      <article data-reveal><p>2023 — 2025</p><h3>New York University</h3><p>Master of Science, Computer Science</p><strong>4.0 / 4.0</strong></article>
      <article data-reveal><p>2017 — 2021</p><h3>Indian Institute of Technology Ropar</h3><p>Bachelor’s degree</p><strong>Top 0.1% in IIT JEE Advanced</strong></article>
    </div>
  </section>

  <section class="contact-band compact">
    <div class="shell" data-reveal><p class="eyebrow">Available for the right problem</p><h2>Let’s compare notes.</h2><a href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>
